<UserControl x:Class="ShieldCordUI.Views.ProtectedAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ShieldCordUI.Controls">

    <!--
      Protected Apps.

      This is the page the mockup's "Computers" screen maps onto most directly:
      an illustrated hero card with the selected item's facts on the right, a
      grid of cards below it, and a dashed tile to add another.

      What it lists is real — the signed applications the engine will let read
      their own token stores, and the publishers the user has additionally
      trusted. There is no device management here because ShieldCord protects
      the one machine it is installed on.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Protected Apps" Style="{StaticResource PageTitle}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0"
                      Padding="0,0,8,0">
            <StackPanel>

                <!-- ══════════ hero: the selected application ══════════ -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nothing selected: the engine has not answered yet, or
                             it genuinely reports no applications. Those are
                             different claims, so the message distinguishes them. -->
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2"
                                    VerticalAlignment="Center" Margin="0,24"
                                    Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}">
                            <controls:AppMark Height="96" HorizontalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Margin="0,16,0,0" MaxWidth="360"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <controls:AppMark Height="120" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource H2}"
                                       FontSize="17" HorizontalAlignment="Center" Margin="0,14,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Selected.Subtitle}" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Margin="0,3,0,0" MaxWidth="280"/>

                            <!-- Status chips. "Running" is process presence, which
                                 the engine really measures. Deliberately not
                                 "Online" or "Updated" — neither is reported, and
                                 both would assert something nothing checked. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,16,0,0">
                                <Border Style="{StaticResource Chip}" Margin="0,0,8,0"
                                        Visibility="{Binding Selected.HasRunState,
                                                     Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Margin="0,0,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource App.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Selected.Running}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource App.Ok}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Selected.RunningText}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource App.Text}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding Selected.Scope}" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.TextMuted}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- the facts, in the mockup's label/value rhythm -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">

                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8">
                                <Run Text="Publisher: " Foreground="{DynamicResource App.TextMuted}"/>
                                <Run Text="{Binding Selected.Publisher, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8">
                                <Run Text="App tag: " Foreground="{DynamicResource App.TextMuted}"/>
                                <Run Text="{Binding Selected.Tag, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- Hidden for a publisher entry: the engine reports
                                 process presence only for the built-in whitelist,
                                 so a run state here would assert a measurement
                                 that was never taken. -->
                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8"
                                       Visibility="{Binding Selected.HasRunState,
                                                    Converter={StaticResource BoolToVis}}">
                                <Run Text="Status: " Foreground="{DynamicResource App.TextMuted}"/>
                                <Run Text="{Binding Selected.RunningText, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,18">
                                <Run Text="Verified by: " Foreground="{DynamicResource App.TextMuted}"/>
                                <Run Text="publisher signature"/>
                            </TextBlock>

                            <Button Content="Refresh" Style="{StaticResource PillButton}"
                                    HorizontalAlignment="Left" MinWidth="150" Margin="0,0,0,8"
                                    Command="{Binding RefreshCommand}"/>
                            <Button Content="View activity" Style="{StaticResource PillButton}"
                                    HorizontalAlignment="Left" MinWidth="150"
                                    Command="{Binding ViewActivityCommand}"/>

                            <!-- The mockup's "Remove Device", mapped to the one
                                 destructive action this page actually has. Shown
                                 only for a publisher the user added — the
                                 built-in entries are compiled into the service
                                 and cannot be removed. -->
                            <Button Style="{StaticResource DangerLink}"
                                    HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Command="{Binding UntrustCommand}"
                                    Visibility="{Binding Selected.Removable,
                                                 Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center"
                                               Margin="0,0,7,0"/>
                                    <TextBlock Text="Stop trusting"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════ the grid ══════════ -->
                <ItemsControl ItemsSource="{Binding Apps}" Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- an application -->
                                <Button x:Name="AppTile" Margin="0,0,14,14"
                                        Command="{Binding DataContext.SelectCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="12"
                                                    Background="{DynamicResource App.Surface}"
                                                    BorderBrush="{DynamicResource App.Border}"
                                                    BorderThickness="1" Padding="16">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{DynamicResource App.Accent}"/>
                                                </Trigger>
                                                <!-- the mockup's selected device card -->
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{DynamicResource App.Accent}"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <StackPanel MinWidth="150">
                                        <controls:AppMark Height="66" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   FontWeight="SemiBold" TextAlignment="Center"
                                                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Text}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    Margin="0,6,0,0"
                                                    Visibility="{Binding HasRunState,
                                                                 Converter={StaticResource BoolToVis}}">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource App.TextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Running}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource App.Ok}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding RunningText}" FontSize="11"
                                                       Foreground="{DynamicResource App.TextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- the dashed add tile, in the same wrap flow -->
                                <Button x:Name="AddTile" Margin="0,0,14,14"
                                        Style="{StaticResource DashedAddCard}"
                                        MinWidth="182" Visibility="Collapsed"
                                        Command="{Binding DataContext.FindPublisherCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <StackPanel>
                                        <!-- a Border, not an Ellipse with a child:
                                             Shape has no content property, so nesting
                                             a glyph inside one is a build failure. -->
                                        <Border Width="46" Height="46" CornerRadius="23"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource App.Accent}">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource App.TextInverse}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Trust a publisher" FontSize="13"
                                                   FontWeight="SemiBold" TextAlignment="Center"
                                                   Margin="0,12,0,0"
                                                   Foreground="{DynamicResource App.Accent}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAddCard}" Value="True">
                                    <Setter TargetName="AppTile" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="AddTile" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
