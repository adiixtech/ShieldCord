<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ShieldCordUI.Converters"
                    xmlns:controls="clr-namespace:ShieldCordUI.Controls">

    <!-- Every brush here is a DynamicResource reference into the active theme
         dictionary (Light.xaml / Dark.xaml), so switching themes at runtime
         re-colours the live window without rebuilding any control. -->

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:NullOrEmptyToVisibilityConverter x:Key="TextToVis"/>
    <conv:InverseBoolConverter x:Key="Not"/>
    <conv:StringEqualsConverter x:Key="IsPage"/>
    <conv:StarWeightConverter x:Key="StarWeight"/>
    <conv:AlertTimeConverter x:Key="AlertTimeFmt"/>
    <conv:ActionLabelConverter x:Key="ActionLabel"/>

    <!-- The inverted twin of TextToVis: shows the element while its bound
         string is still empty. That is what a search field's placeholder
         needs, and it has to be a separate instance because Invert is a
         property on the converter rather than a ConverterParameter. -->
    <conv:NullOrEmptyToVisibilityConverter x:Key="TextToVisInv" Invert="True"/>

    <!-- ══════════ typography ══════════ -->

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
    </Style>

    <!-- ══════════ surfaces ══════════ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ══════════ switch ══════════ -->

    <!-- A real sliding switch rather than a checkbox: these control live
         protection, and the on/off state must be readable at a glance.

         The knob is moved by animating a TranslateTransform rather than by
         swapping HorizontalAlignment. That is not a style preference — the
         alignment swap is a LAYOUT change, so it snaps instantly and a
         DoubleAnimation on it throws outright ("cannot animate
         HorizontalAlignment"). A transform is resolved on the composition
         thread, so this slides at full frame-rate even while the UI thread is
         busy polling the engine. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                Background="{DynamicResource App.SurfaceSunken}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="16" Height="16"
                                     Fill="{DynamicResource App.TextMuted}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"
                                     controls:ToggleSlide.On="True">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>

                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource App.Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource App.Accent}"/>
                            <Setter TargetName="Knob" Property="Fill"
                                    Value="{DynamicResource App.TextInverse}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource App.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ buttons ══════════ -->

    <!--
      Shared press feedback.

      These two storyboards are referenced by every button template, and they
      work because they target a template element by the name ALL of them use:
      the visual root of every button template in this file is a Border called
      "Bd". That is a real contract — add a button template whose root is named
      anything else, reference these, and it throws on the first click (loudly,
      through the app's crash reporter, but still avoidable).

      Pressing scales the surface to 0.97. Scale is a composition-thread
      property, so this stays smooth even while the UI thread is busy — and on
      this app it often is: most buttons kick off a UAC round trip, and the
      feedback has to land BEFORE the prompt appears or the user clicks twice.

      The transform lives on the template's Border rather than on the Button via
      a Style setter. A Setter's value is shared across every element using that
      style, so a ScaleTransform set there would be one instance animating every
      button in the app at once.
    -->
    <Storyboard x:Key="Motion.PressDown" x:Shared="False">
        <DoubleAnimation Storyboard.TargetName="Bd"
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="0.97" Duration="{StaticResource Motion.Instant}"
                         EasingFunction="{StaticResource Motion.EaseOut}"/>
        <DoubleAnimation Storyboard.TargetName="Bd"
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="0.97" Duration="{StaticResource Motion.Instant}"
                         EasingFunction="{StaticResource Motion.EaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="Motion.PressUp" x:Shared="False">
        <DoubleAnimation Storyboard.TargetName="Bd"
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="1" Duration="{StaticResource Motion.Instant}"
                         EasingFunction="{StaticResource Motion.EaseOut}"/>
        <DoubleAnimation Storyboard.TargetName="Bd"
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="1" Duration="{StaticResource Motion.Instant}"
                         EasingFunction="{StaticResource Motion.EaseOut}"/>
    </Storyboard>

    <!--
      Keyboard focus ring, applied to every button through FocusVisualStyle.

      FocusVisualStyle rather than a border on the template, and that choice is
      the whole point: this renders in an ADORNER, outside the element's layout
      box (the -3 margin below). Drawing a focus border on the template itself
      would change the button's size the moment it was tabbed to, shifting
      everything after it.

      WPF shows this only when focus arrived from the KEYBOARD, not from a
      click, which is the correct behaviour — a ring that appears when you click
      a button reads as a stuck state.
    -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="9" RadiusY="9"
                               Stroke="{DynamicResource App.Accent}" StrokeThickness="2"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource App.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.TextInverse}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressDown}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressUp}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                            CornerRadius="7" Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressDown}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressUp}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Its own template, not BasedOn PrimaryButton: that template hard-codes
         App.AccentHover in its hover trigger, so a derived style could only
         change the resting colour and every red destructive button would
         repaint in the blue accent under the cursor. -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource App.Danger}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.TextInverse}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.DangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressDown}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressUp}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressDown}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressUp}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ window chrome buttons ══════════ -->

    <!-- 44x44: the full height of the caption strip, so the buttons sit flush in
         the top-right corner the way Windows' own do. They were 32 tall, which
         left a 6px strip above them — and that strip was not slack. Measured
         with WM_NCHITTEST down the close button's column, the window answers
         HTTOP for the first 6 pixels and HTCLIENT from 6 down: it is exactly the
         WindowChrome resize band. So the buttons can only be flush by sitting
         over it, and the top few pixels of a caption button starting a window
         resize is what native Windows does too. Everything left of the buttons
         still resizes from the top edge as before. -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                        </Trigger>
                        <!-- Press is a fill, not the shared scale used elsewhere: a
                             caption button shrinking under the cursor reads as a
                             bug. Windows' own caption buttons do exactly this. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.SurfaceSunken}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The conventional red close hover, with the inverse text colour so the
         glyph stays legible on it in both themes. Previously this style forced
         a literal White foreground while inheriting the base template's
         near-transparent hover fill — white on a light background, so the close
         glyph vanished under the cursor in the light theme. -->
    <Style x:Key="CloseChromeButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.Danger}"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.TextInverse}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.DangerHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.TextInverse}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ sidebar navigation ══════════ -->

    <!-- Leading glyph comes from the RadioButton's Tag, which is the one free
         property on a nav row that has no other meaning. The inner TextBlocks
         deliberately set NO Foreground of their own: a local value beats
         inheritance, so setting one would make the IsChecked trigger unable to
         reach them and the active row would silently lose its colour. -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Reveal is attached to the Border, not the inner Grid: the
                         Border already has Background="Transparent" so it is
                         hit-testable, and the behaviour puts its glow into the
                         Grid below. See Controls/Reveal.cs for the constraints. -->
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,9"
                            SnapsToDevicePixels="True"
                            controls:Reveal.On="True" controls:Reveal.CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- The glyph nudges right by 1px when the row is live.
                                 A 1px transform is enough to register as response
                                 without the row appearing to move. -->
                            <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Text="{TemplateBinding Tag}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glyph"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Instant}"
                                                         EasingFunction="{StaticResource Motion.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glyph"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Instant}"
                                                         EasingFunction="{StaticResource Motion.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.AccentSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ animated card ══════════ -->

    <!--
      The plain card: same look as Card, plus a hover response.

      The lift is a 1px translate, NOT a scale. Scaling a card holding text
      resamples the glyphs (they go soft at fractional scales) and needs
      RenderOptions fiddling to look right; a translate stays pixel-crisp and
      reads as just as much movement at this size.

      Opt-in rather than the default, because it should only apply to cards that
      are actually interactive — a lifting card that does nothing when clicked
      teaches the user to distrust the app's affordances.
    -->
    <Style x:Key="InteractiveCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                             To="-1"
                                             Duration="{StaticResource Motion.Instant}"
                                             EasingFunction="{StaticResource Motion.EaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                             To="0"
                                             Duration="{StaticResource Motion.Instant}"
                                             EasingFunction="{StaticResource Motion.EaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════ filter pills ══════════ -->

    <Style x:Key="Pill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                            Padding="12,4">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource App.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ alert list ══════════ -->

    <Style x:Key="AlertItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="10,8" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ slim scrollbar ══════════ -->

    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource App.Border}"
                                                    CornerRadius="4" Margin="3,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         Shell vocabulary
         ══════════════════════════════════════════════════════════════════
         Additive only. Nothing below is referenced by a view until the view
         that wants it is rebuilt, which is what lets the styles land in one
         step and be proven not to have changed a single pixel on their own.

         Everything existing above this line is load-bearing and must keep its
         name: Card is BasedOn by a local style in DashboardView AND another in
         SettingsView, and SecondaryButton / DangerButton both derive from
         PrimaryButton. Renaming any of the three breaks those silently.
         ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
    </Style>

    <!-- The figure in a dashboard figure card. Sized to sit in a four-across
         strip rather than one per card: at the old 34 the four of them competed
         with the page title, and the strip had to be tall enough to hold them. -->
    <Style x:Key="StatNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
    </Style>

    <!-- ══════════ pill buttons ══════════ -->

    <!-- The mockup's dominant control: a fully rounded outline. Two styles
         rather than one BasedOn pair, because each needs its own hover
         treatment and a shared template could only ever hard-code one of
         them. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="{DynamicResource App.Accent}" BorderThickness="1"
                            CornerRadius="18" Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressDown}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressUp}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SolidPillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource App.TextInverse}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource App.Accent}"
                            CornerRadius="18" Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressDown}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressUp}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The mockup's "Remove Device": a destructive action that reads as a
         link, not a button, so it never competes with the primary action. -->
    <Style x:Key="DangerLink" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource App.Danger}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.DangerSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressDown}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressUp}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ top bar ══════════ -->

    <!-- The fixed 34 is the hit target, not a layout container — the caption
         strip it sits in is Auto-sized either way. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="17"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource App.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressDown}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.PressUp}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ search field ══════════ -->

    <!-- The magnifier glyph and the placeholder are NOT in this template: both
         are overlaid by the view, because the placeholder has to disappear the
         moment the user types and that is a binding on the TextBox's own Text,
         not something the template can see. Padding on the left reserves the
         room the glyph needs. -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource App.Text}"/>
        <Setter Property="Background" Value="{DynamicResource App.SurfaceSunken}"/>
        <Setter Property="Padding" Value="32,8,10,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!--
                      The Border deliberately does NOT apply the TextBox's Padding.

                      WPF already insets the content by Padding — PART_ContentHost
                      carries it (measured: a TextBox with Padding="33,0,34,0" gave
                      its ScrollViewer Padding="33,0,34,0" too). Putting the same
                      Padding on the Border as well applied it twice, so the first
                      glyph landed at 33 + 1 + 33 = 67 while the placeholder drawn
                      beside it sat at 33. The caret appeared a third of the way
                      into the field, in a box that looked empty to its left.

                      One inset, applied by the framework. The Border only draws.
                    -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                            CornerRadius="8" Padding="0">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource App.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ cards ══════════ -->

    <!-- A Button, not a Border: the mockup's dashed "Add Device" card is an
         affordance, so it needs a Command, a hover state and a disabled state,
         and a Border would have to grow all three by hand. -->
    <Style x:Key="DashedAddCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="Dash" RadiusX="12" RadiusY="12"
                                   Fill="{DynamicResource App.Surface}"
                                   Stroke="{DynamicResource App.Border}"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="4 3"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="16"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dash" Property="Stroke"
                                    Value="{DynamicResource App.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ chips & charts ══════════ -->

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceSunken}"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Bar" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource App.Accent}"/>
        <Setter Property="RadiusX" Value="3"/>
        <Setter Property="RadiusY" Value="3"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="3"/>
    </Style>

</ResourceDictionary>
