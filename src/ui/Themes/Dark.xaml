<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Dark palette. Same keys as Light.xaml — that is the whole contract.
      A key defined in one and missing from the other shows up as an unthemed
      element when the user switches, so keep the two lists identical.
    -->

    <SolidColorBrush x:Key="App.Background"  Color="#0F1115"/>
    <SolidColorBrush x:Key="App.Surface"     Color="#171A21"/>
    <SolidColorBrush x:Key="App.SurfaceAlt"  Color="#14171D"/>
    <SolidColorBrush x:Key="App.SurfaceSunken" Color="#11141A"/>
    <SolidColorBrush x:Key="App.Border"      Color="#262B36"/>
    <SolidColorBrush x:Key="App.BorderSoft"  Color="#1E222B"/>
    <SolidColorBrush x:Key="App.Hover"       Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="App.Selected"    Color="#334C90E8"/>

    <SolidColorBrush x:Key="App.Text"        Color="#E8EAF0"/>
    <SolidColorBrush x:Key="App.TextMuted"   Color="#98A0B0"/>
    <SolidColorBrush x:Key="App.TextInverse" Color="#0F1115"/>

    <SolidColorBrush x:Key="App.Accent"      Color="#4C90E8"/>
    <SolidColorBrush x:Key="App.AccentHover" Color="#6BA5F0"/>
    <SolidColorBrush x:Key="App.AccentSoft"  Color="#15243B"/>

    <SolidColorBrush x:Key="App.Ok"          Color="#34D399"/>
    <SolidColorBrush x:Key="App.OkSoft"      Color="#102A20"/>
    <SolidColorBrush x:Key="App.Warn"        Color="#FBBF24"/>
    <SolidColorBrush x:Key="App.WarnSoft"    Color="#2A2110"/>
    <SolidColorBrush x:Key="App.Danger"      Color="#F87171"/>
    <SolidColorBrush x:Key="App.DangerHover" Color="#EF4444"/>
    <SolidColorBrush x:Key="App.DangerSoft"  Color="#2C1517"/>

    <!-- Same four keys as Light.xaml — see the note there. Lifted toward the
         light end so they stay separable against a #171A21 card rather than
         muddying into it. -->
    <SolidColorBrush x:Key="App.Chart1"      Color="#60A5FA"/>
    <SolidColorBrush x:Key="App.Chart2"      Color="#A78BFA"/>
    <SolidColorBrush x:Key="App.Chart3"      Color="#FBBF24"/>
    <SolidColorBrush x:Key="App.Chart4"      Color="#E879F9"/>

    <SolidColorBrush x:Key="App.Shadow"      Color="#66000000"/>

</ResourceDictionary>
